# NOTE: Docker applies this to every build in the repo, including Dockerfile.render
# which DOES need frontend/. So we keep frontend/ in context and instead exclude
# the heavy/nested bits with **/ globs.

# secrets & data — never baked into an image (mounted / injected at runtime)
.env
.auth_store.json
.m4_cache.json
intel/
*.mmdb
*.db
*.sqlite*
samples/private/

# local environments, VCS, build caches (nested-safe globs)
venv/
.git/
**/node_modules
**/dist
frontend_dist/
**/__pycache__
*.pyc
.pytest_cache/
.ruff_cache/
.DS_Store

# scratch / test artefacts
*.log
full_test_results.json
test_results.json
