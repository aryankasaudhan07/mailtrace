# Mailtrace — web app (Next.js) environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# Everything here is optional unless marked REQUIRED — the app degrades
# gracefully (analyzers return UNAVAILABLE rather than failing).

# ---- Auth (REQUIRED in production) ------------------------------------
# HMAC secret used to sign session tokens. If unset, the code falls back to a
# hard-coded dev default that is public in the source — anyone could then forge
# a valid session. Always set this in production.
#   generate with:  openssl rand -hex 32
AUTH_SECRET=

# ---- Email: OTP for sign-up and password reset ------------------------
# Sent over SMTP via nodemailer. For Gmail you need an App Password (16 chars,
# requires 2-Step Verification) — not your account password. Spaces are fine.
# Without these the API returns the code in the response as `demo_otp` instead
# of emailing it.
SMTP_USER=you@example.com
SMTP_PASSWORD=your-16-char-app-password
MAIL_FROM=you@example.com
# Optional — defaults shown. Port 465 switches to implicit TLS, 587 uses STARTTLS.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
# Accepted fallback aliases: SMTP_PASS (for SMTP_PASSWORD), SMTP_FROM (for MAIL_FROM)

# ---- AI: M4 content analyzer ------------------------------------------
# Google Gemini key. Without it M4 falls back to deterministic heuristics, so
# the lane still returns evidence — just without the LLM signal.
GEMINI_API_KEY=
# LLM_API_KEY is read as a fallback if GEMINI_API_KEY is unset.
#LLM_API_KEY=

# ---- Storage: Vercel KV (Upstash Redis) -------------------------------
# Set automatically when you link Vercel KV. Without either, users, cases and
# OTPs live in memory — fine locally, but they reset on every restart.
#KV_REST_API_URL=
#KV_URL=

# ---- Intel & analyzer behaviour ---------------------------------------
# Offline GeoLite2 / Tor / VPN databases. Defaults to ../intel — populate with
# scripts/fetch_intel.sh. Never commit .mmdb files.
#INTEL_DIR=../intel
# Set to 1 to disable online geolocation (ip-api.com) and rely on offline data.
#GEO_DISABLE_ONLINE=
# Set to 0 to stop M8 making live footprint lookups (Gravatar / breach checks).
#M8_ENUM_ONLINE=
# Have I Been Pwned key, used by M8 for breach lookups.
#HIBP_API_KEY=

# ---- Trust boundary ----------------------------------------------------
# Comma-separated MX hosts / CIDRs treated as our own infrastructure. The
# earliest hop that authenticates against these is the reported origin;
# everything below it is labelled unverified.
#TRUSTED_MX_HOSTS=mx.example.ac.in
#TRUSTED_MX_CIDRS=

# ---- Misc --------------------------------------------------------------
# Defaults to 1. Set to 0 to leave fixture mode.
#FIXTURE_MODE=1
