# Copy to .env and fill in. Never commit .env.

# ---- runtime ----
# FIXTURE_MODE=1 lets the API serve fixtures/*.json with no DB and no network.
# Track F should develop the entire dashboard in this mode.
FIXTURE_MODE=1
LOG_LEVEL=INFO

# ---- database ----
DATABASE_URL=postgresql+psycopg://mailtrace:mailtrace@db:5432/mailtrace
REDIS_URL=redis://cache:6379/0

# ---- trust boundary (M2) ----
# Comma-separated. Hosts and CIDRs you control, plus providers whose
# Received lines you accept as authentic. Everything below the last match
# in the chain is treated as forgeable.
TRUSTED_MX_HOSTS=mx.example.ac.in,mail.example.ac.in
TRUSTED_MX_CIDRS=203.0.113.0/24
TRUSTED_PROVIDERS=google.com,outlook.com,protection.outlook.com

# ---- intel (Track D) ----
INTEL_DIR=./intel
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
IPINFO_TOKEN=
ABUSEIPDB_KEY=
VIRUSTOTAL_KEY=
URLSCAN_KEY=

# ---- content intel (Track C) ----
LLM_API_KEY=
LLM_MODEL=
