# Single-image production build: Node builds the React UI, Python serves the API
# AND the built UI from one origin. Used by Render (and any single-container host).

# --- stage 1: build the frontend ---
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# --- stage 2: python runtime ---
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq5 libcairo2 libpango-1.0-0 libpangocairo-1.0-0 \
        libgdk-pixbuf-2.0-0 libffi-dev curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# App code (frontend/ is excluded by .dockerignore — we bring the built bundle in)
COPY . .
COPY --from=web /web/dist ./frontend_dist

ENV FIXTURE_MODE=1
EXPOSE 8000
# Render (and most PaaS) inject $PORT; fall back to 8000 locally.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
